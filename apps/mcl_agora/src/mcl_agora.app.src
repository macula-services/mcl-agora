{application, mcl_agora, [
    {description, "The agora's record keeper: it records every post the minds publish to the square, so the record outlives the speakers"},
    {vsn, "0.4.0"},
    {registered, [mcl_agora_sup]},
    {mod, {mcl_agora_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% Mesh SDK, realm identity, capabilities, health.
        mcl_om,
        %% This service's own event store (mcl_agora_store opens it).
        reckon_db,
        %% The departments, started before this app so their projection is
        %% registered when mcl_agora_app opens the store and its subscription
        %% replays.
        guide_agora_post_lifecycle,
        project_agora_posts,
        query_agora_posts
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-agora"}]}
]}.
