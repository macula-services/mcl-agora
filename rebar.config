%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_agora.
%%
%% The agora's record keeper: it records every post the minds publish to the square, so the record outlives the speakers
%%
%% An umbrella of four apps: guide_agora_post_lifecycle (CMD, the listener on
%% the square and the agora_post aggregate, event sourced), project_agora_posts
%% (PRJ, the posts read model), query_agora_posts (QRY, get_posts_page) and
%% mcl_agora (the service: the contract and the store wiring).

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% It opens no store from 0.35 on (mcl-om#10): mcl_agora_app opens this
    %% service's own (mcl_agora_store) before mcl_om:boot/1. Our libraries float
    %% at ~> MAJOR.MINOR, released versions only.
    {mcl_om, "~> 1.6"},
    %% Declared directly because the CMD listener subscribes and the mesh
    %% emitter publishes through macula itself, and because the get_posts_page
    %% desk implements macula_response. 16.0 keeps wire 1.0, so this service
    %% still speaks to every wire 1.0 box; what it brings is the revocation
    %% bound (macula#118): an endorsement admits for at most 24 hours, and a
    %% gated overlay context must pass `member_standing'. This service gates no
    %% overlay and issues no endorsement, so nothing here changes.
    {macula, "~> 18.0"},
    %% THIS SERVICE'S OWN EVENT STORE, opened by mcl_agora_app before
    %% mcl_om:boot/1 (mcl_om 0.35 brings none of these). evoq 1.24 marks a
    %% restart's replayed events, which is what lets the mesh emitter declare
    %% replay_policy() -> skip and not re-announce the whole record on every
    %% boot. reckon_evoq 2.7.2 reads snapshots back whole.
    {reckon_db,   "~> 5.4"},
    {evoq,        "~> 1.26"},
    {reckon_evoq, "~> 2.7"}
]}.

%% khepri 0.17 (via reckon_db) uses the deprecated `catch' expression, which
%% warnings_as_errors refuses on OTP 28+.
{overrides, [
    {override, khepri, [{erl_opts, [nowarn_deprecated_catch]}]}
]}.

{project_plugins, [rebar3_lint]}.

%% xref. A call to a function that does not exist fails the build, and only that
%% check: `exports_not_used' is off deliberately, because a supervisor spec, a test
%% or a facade names the function instead of calling it, so xref cannot see the use
%% (macula-services/mcl-om#39). Spelled out rather than left to rebar3's default,
%% which counts exports nobody calls as failures.
{xref_checks, [undefined_function_calls]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}},
            {elvis_style, max_function_length, #{max_length => 60}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% The listener and the emitter call macula, the aggregate, the desks and the
%% projection implement evoq's behaviours, and agora_post_stream_id_tests asks
%% reckon_gater_stream_id whether the id it builds is one reckon-db will accept
%% -- the check whose absence let an invalid stream id through a green suite.
%% None is a direct dependency, so none is in the PLT unless it is named here.
{dialyzer, [{plt_extra_apps, [macula, evoq, reckon_gater]}]}.

{relx, [
    {release, {mcl_agora, "0.5.0"}, [guide_agora_post_lifecycle, project_agora_posts,
                                     query_agora_posts, mcl_agora, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    %% meck stands in for the mesh where a test needs to see exactly what the
    %% listener hands on, without a live station.
    {test, [{deps, [{meck, "~> 1.2"}]}]},
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
